# ---------------------------------------------------------------
# Public repository / Zenodo archive: reproducibility material only
# (code, ontology, shapes, queries, rules, contracts, inputs that
# the scripts read, generated outputs, protocols, README/CITATION).
# Everything below stays local.
# ---------------------------------------------------------------

# Python / OS / editor noise
__pycache__/
*.pyc
.DS_Store
Thumbs.db
*.tmp
~$*
.~lock.*#
_b*.md

# Local dependency caches and third-party software (obtain from upstream)
.jws_deps/
.jws_external_deps/
jws_external/

# Manuscript drafts, revision notes, cover letters, waiver/ethics letters,
# review bundles and release-candidate zips (not reproducibility material)
jws_submission/
jws_revision/

# Local audit runs and scratch folders
package_audit_*/
tmp/

